# Everything here is optional. The normal way to add AI keys is in the app:
# Settings → API keys (stored locally, never committed). Values set here take
# precedence over keys saved in Settings.

# AI keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenAI model overrides
OPENAI_MODEL=gpt-4o-mini
# OPENAI_CAMPAIGN_MODEL=gpt-4.1
# OPENAI_IMAGE_MODEL=gpt-image-1

# Release credentials, only needed to publish builds (see scripts/release-*.js)
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# WINDOWS_CERT_THUMBPRINT=
